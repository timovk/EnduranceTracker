{
  "name": "endurance-racing-career",
  "version": "0.3.2",
  "private": true,
  "description": "A career mode for watching endurance racing — your library, your hours, your record.",
  "author": "Endurance Racing Career",
  "main": "desktop/out/main.js",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "desktop:build": "tsc -p desktop/tsconfig.json",
    "desktop:dev": "npm run desktop:build && electron desktop/out/main.js",
    "desktop:start": "npm run desktop:build && electron desktop/out/main.js --standalone",
    "desktop:rebuild": "electron-rebuild -f -w better-sqlite3",
    "desktop:prepare": "next build && node scripts/desktop/prepare-standalone.mjs",
    "desktop:icon": "node scripts/desktop/make-icon.mjs",
    "desktop:pack": "npm run desktop:rebuild && npm run desktop:build && npm run desktop:prepare && electron-builder --linux dir --publish never",
    "dist:win": "npm run db:generate && npm run desktop:rebuild && npm run desktop:build && npm run desktop:prepare && electron-builder --win nsis portable --x64 --publish never",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "db:reset": "prisma migrate reset --force",
    "db:seed": "tsx scripts/seed.ts",
    "db:seed:demo": "tsx scripts/seed.ts --demo",
    "db:unseed:demo": "tsx scripts/seed.ts --remove-demo",
    "db:recompute": "tsx scripts/recompute.ts",
    "postinstall": "prisma generate",
    "changelog": "tsx scripts/changelog.ts"
  },
  "dependencies": {
    "@prisma/adapter-better-sqlite3": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "better-sqlite3": "^12.11.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "lucide-react": "^1.47.0",
    "next": "16.3.5",
    "prisma": "^7.10.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "recharts": "^3.10.1",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "@tailwindcss/postcss": "^4",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^3.2.7",
    "dotenv-cli": "^11.0.0",
    "electron": "^38.8.6",
    "electron-builder": "^26.15.3",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "playwright": "^1.63.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^3.2.7"
  }
}
