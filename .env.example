# ---------------------------------------------------------------------------
# Endurance Racing Career Mode
# ---------------------------------------------------------------------------

# Where your careers are stored. This is a SQLite file — nothing to install and
# nothing to run. It holds every account on this machine.
#
# To back it up, use Career → Back up career… in the desktop application: it
# copies the database safely while the app has it open. Copying the .db file by
# hand can miss the -wal file sitting beside it, and with it the most recent
# session you logged.
DATABASE_URL="file:./endurance.db"

# Optional, and only the demonstration seed reads it: the account id
# `npm run db:seed:demo` creates its sample career under. The application
# itself resolves the account from whoever is signed in, so nothing else in
# the codebase looks at this.
ENDURANCE_USER_ID="00000000-0000-4000-8000-000000000001"
