# ---------------------------------------------------------------------------
# Endurance Racing Career Mode
# ---------------------------------------------------------------------------

# Where your career is stored. This is a SQLite file — nothing to install and
# nothing to run. Back up your history by copying it.
DATABASE_URL="file:./endurance.db"

# This is a single-user application; this id owns the one career profile.
# Change it only if you want to start an entirely separate career.
ENDURANCE_USER_ID="00000000-0000-4000-8000-000000000001"
