# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# The compiled desktop shell. Rebuilt by `npm run desktop:build`; committing it
# would mean reviewing generated JavaScript on every change to desktop/src.
/desktop/out/

# Installers and unpacked application trees from electron-builder.
/dist/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...but the template has to ship, or a fresh clone cannot follow the README.
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma

# Agent/editor tooling installed by `prisma init`. Useful locally, but it is
# vendor documentation rather than part of this application, so it stays out
# of the repository.
/.agents
/.claude
/.windsurf
/skills-lock.json

# The database. Your viewing history lives here — it is yours, not the repo's.
*.db
*.db-journal
*.db-wal
*.db-shm
# ...except the test fixtures: databases written by a released version, kept so
# every later version is tested against what that one really wrote. They hold
# only demonstration data. See tests/fixtures/README.md.
!tests/fixtures/*.db
