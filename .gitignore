# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...but the template has to ship, or a fresh clone cannot follow the README.
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma

# Agent/editor tooling installed by `prisma init`. Useful locally, but it is
# vendor documentation rather than part of this application, so it stays out
# of the repository.
/.agents
/.claude
/.windsurf
/skills-lock.json

# The database. Your viewing history lives here — it is yours, not the repo's.
*.db
*.db-journal
*.db-wal
*.db-shm
